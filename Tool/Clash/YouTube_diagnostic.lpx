#!name=YouTube私有对照诊断
#!desc=移除YouTube视频、瀑布流、搜索和Shorts中的广告，移除底栏的Shorts按钮和上传按钮，增加画中画及字幕翻译功能。移除YouTube Music底栏的上传、选段和升级按钮，增加歌词翻译，支持二者的后台播放。此插件需要启用MitM over HTTP/2和QUIC回退保护。支持Premium订阅用户使用，不支持tvOS设备。
#!openUrl=https://apps.apple.com/app/id544007664
#!author=Maasea[https://github.com/Maasea], VirgilClyne[https://github.com/VirgilClyne], Choler[https://github.com/Choler], DivineEngine[https://github.com/DivineEngine], app2smile[https://github.com/app2smile]
#!tag=去广告
#!system=iOS, iPadOS, macOS
#!system_version=15
#!loon_version=3.5.1(998)
#!homepage=https://github.com/Simonxiaoxueboshi/clash-modules
#!icon=https://raw.githubusercontent.com/Simonxiaoxueboshi/clash-modules/main/Icon/App_icon/120px/YouTube.png
#!date=2026-11-05

[Argument]
blockUpload=switch, false, true, tag=隐藏上传按钮, desc=用于隐藏YouTube底栏的上传按钮
blockShorts=switch, false, true, tag=隐藏Shorts按钮, desc=用于隐藏YouTube底栏的Shorts按钮
blockImmersive=switch, false, true, tag=隐藏选段按钮, desc=用于隐藏YouTube Music底栏的选段按钮
captionLang=select, "zh-Hans", "zh-Hant", "ja", "ko", "en", "off", tag=字幕翻译语言, desc=需要把YouTube字幕翻译翻译为何种语言
debug=switch, false, true, tag=启用调试模式, desc=此插件的调试模式

[Rule]
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,googlevideo.com)),REJECT
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,youtubei.googleapis.com)),REJECT
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN,youtubei-att.googleapis.com)),REJECT
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,youtube.com)),REJECT
AND,((PROTOCOL,UDP),(DEST-PORT,443),(DOMAIN-SUFFIX,youtu.be)),REJECT

[Script]
# 只关闭 Onesie 信封外层的片头广告标志，原始与修改后请求仅发送到本地诊断接收器。
request if ${url} ~= /^https:\/\/[a-z0-9-]+\.googlevideo\.com\/initplayback(?:\?[^#]*)?$/i && ${request.method} == "POST" && ${request.headers.User-Agent} ~= /(?:^|\s)com\.google\.ios\.youtube\//i then script("https://raw.githubusercontent.com/Simonxiaoxueboshi/clash-modules/43d5874/Resource/JavaScript/YouTube/YouTube_remove_ads/YouTube_init_capture.js") with tag="YouTube片头广告标志", requires_body=true, binary_body_mode=true

# 在 player/get_watch 请求中去除广告参数，并请求内联无广告播放。
request if ${url} ~= /^https:\/\/youtubei(?:-att)?\.googleapis\.com\/youtubei\/v1\/(?:player|get_watch)(?:\?[^#]*)?$/i then script("https://raw.githubusercontent.com/Simonxiaoxueboshi/clash-modules/43d5874/Resource/JavaScript/YouTube/YouTube_remove_ads/YouTube_playback_request.js") with tag="YouTube播放请求", requires_body=true, binary_body_mode=true

response if ${url} ~= /^https:\/\/youtubei(?:-att)?\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$/i then script("https://raw.githubusercontent.com/Simonxiaoxueboshi/clash-modules/c092087/Resource/JavaScript/YouTube/YouTube_remove_ads/YouTube_remove_ads_response.js", {${blockUpload}, ${blockShorts}, ${blockImmersive}, ${captionLang}, ${debug}}) with tag="YouTube去广告", requires_body=true, binary_body_mode=true

request if ${url} ~= /^https:\/\/youtubei(?:-att)?\.googleapis\.com\/youtubei\/v1\/player\/ad_break(?:\?[^#]*)?$/i then script("https://raw.githubusercontent.com/Simonxiaoxueboshi/clash-modules/c092087/Resource/JavaScript/YouTube/YouTube_remove_ads/YouTube_ad_break_block.js") with tag="广告配置拦截"

request if ${url} ~= /^https:\/\/youtubei(?:-att)?\.googleapis\.com\/youtubei\/v1\/log_event/i then script("https://raw.githubusercontent.com/Simonxiaoxueboshi/clash-modules/c092087/Resource/JavaScript/YouTube/YouTube_remove_ads/YouTube_remove_ads_request.js", {${blockUpload}, ${blockShorts}, ${blockImmersive}, ${captionLang}, ${debug}}) with tag="请求日志事件", requires_body=true, binary_body_mode=true

[MitM]
hostname=*.googlevideo.com, youtubei.googleapis.com, youtubei-att.googleapis.com